# =============================================================================
# Argos Ops — .env.example
#
# Copie ce fichier vers .env.local (dev) ou .env (prod).
# JAMAIS committer .env.local ou .env (gitignored).
# =============================================================================

# --- Core ---
ARGOS_OPS_LOG_LEVEL=INFO

# --- Database (Postgres + pgvector) ---
# Prod : DB argos_ops sur cluster sechunter-postgres-1 (D-002)
# Dev local : adapter selon votre setup local
DATABASE_URL=postgresql://argos_ops:CHANGE_ME@localhost:5432/argos_ops

# --- Redis ---
# Prod : DB index 3 (SecHunter utilise 0-2)
REDIS_URL=redis://localhost:6379/3

# --- Google AI Studio (Gemini) — DÉPRÉCIÉ pour Argos Ops par D-017 ---
# Argos Ops ne l'utilise plus : agents via Claude Code Pro Max, embeddings KB
# via fastembed local (paraphrase-multilingual-mpnet-base-v2). Conservé
# optionnel uniquement si tu utilises ce repo pour piloter le scanner
# SecHunter BYOK (D-011, produit séparé). Laisse vide sinon.
GEMINI_API_KEY=

# --- Discord ---
# 4 webhooks, un par canal (cf. P1.B)
DISCORD_WEBHOOK_DIGEST=
DISCORD_WEBHOOK_ESCALATIONS=
DISCORD_WEBHOOK_ALERTS=
DISCORD_WEBHOOK_OPS_LOGS=
# Optionnel — webhook dédié inbox EmailBot (P5). Fallback sur ESCALATIONS si vide.
DISCORD_WEBHOOK_INBOX=
# User ID du fondateur pour @mentions sur breakers critiques
DISCORD_FOUNDER_USER_ID=

# --- Reddit retiré du périmètre Argos Ops par D-022 (2026-05-15) ---
# (Vars supprimées : REDDIT_CLIENT_ID, REDDIT_CLIENT_SECRET, REDDIT_USER_AGENT)

# --- Outbound (P13 — shadow mode par défaut) ---
# Live mode = envoi réel via SMTP depuis le domaine secondaire.
# Reste sur false tant que le domaine n'est pas acheté + warmed-up 4 semaines.
OUTBOUND_LIVE_MODE=false
# Domaine secondaire sacrificiel (P13 § 13.2) — ex: try-omnividens.com
OUTBOUND_FROM_DOMAIN=
# Secret HMAC pour signer les liens d'opt-out (génère via : python -c "import secrets; print(secrets.token_hex(32))")
OUTBOUND_UNSUBSCRIBE_SECRET=
# Cap journalier d'envois (warmup commence à 5, croisière 30-50)
OUTBOUND_DAILY_MAX=30

# --- Mastodon (remplace X — D-004 — à remplir avant P11) ---
# Création token :
#   1. https://infosec.exchange/settings/applications → "New application"
#   2. Scopes : write:statuses + read:accounts (le reste décoché)
#   3. Copier "Your access token" ici (révoquer + régénérer si fuite)
# Test live : uv run python scripts/test_mastodon.py
MASTODON_INSTANCE_URL=https://infosec.exchange
MASTODON_ACCESS_TOKEN=

# --- Bluesky (AT Protocol — gratuit illimité, Sprint B) ---
# Setup :
#   1. Créer/utiliser un compte sur https://bsky.app
#   2. Settings → App Passwords → "Add App Password" (nommer "argos-ops")
#   3. Copier le mot de passe généré (format xxxx-xxxx-xxxx-xxxx) ci-dessous
#      — JAMAIS le vrai mot de passe du compte. Révocable indépendamment.
# Handle = identifiant complet, ex. omnividens.bsky.social (ou domaine custom).
# Shadow tant que HANDLE ou APP_PASSWORD manque.
# Test live : uv run python scripts/test_bluesky.py
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# PDS host — laisser bsky.social sauf self-host AT Protocol.
BLUESKY_PDS_URL=https://bsky.social

# --- Meta / Facebook Page (organique — persona TPE/PME) ---
# DISTINCT de Meta Ads (META_ADS_* plus bas). Ici = posts organiques gratuits
# sur la Page Facebook Argos. Setup OAuth via Meta Business Suite.
#   1. Meta Business Suite → app + Page liée
#   2. Graph API Explorer → token utilisateur avec scope pages_manage_posts +
#      pages_read_engagement, puis échange en token de Page LONG-LIVED (60j)
#   3. META_PAGE_ID = ID numérique de la Page (Page → À propos)
# Shadow tant que PAGE_ID ou ACCESS_TOKEN manque. Test : scripts/test_meta.py
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Version Graph API — bump si dépréciée par Meta (cycle ~2 ans).
META_GRAPH_API_VERSION=v21.0

# --- X / Twitter (Sprint contenu — DRAFT-ONLY, activation reportée) ---
# Canal bas priorité : le fondateur arbitrera Free vs Basic ($) avant le live.
# D'ici là le connecteur reste en shadow (drafte, ne poste pas).
# Setup (quand on décidera de l'activer) :
#   1. developer.twitter.com → Projects & Apps → créer une app dans un Projet
#   2. User authentication settings → OAuth 2.0, App type "Web/Native",
#      scopes : tweet.write + tweet.read + users.read (+ offline.access pour le refresh)
#   3. Faire le flow OAuth 2.0 (Authorization Code + PKCE) → récupérer l'ACCESS
#      TOKEN utilisateur (PAS l'app-only bearer, qui ne peut pas publier)
# ⚠️ Le token OAuth 2.0 expire (~2h) → un refresh sera nécessaire pour du live
#    durable (à câbler le moment venu). Test : scripts/test_twitter.py
X_ACCESS_TOKEN=
# Base API — laisser tel quel sauf besoin spécifique.
X_API_BASE=https://api.twitter.com

# --- Truth Social (fork Mastodon — DRAFT-ONLY, le plus expérimental) ---
# Même API que Mastodon (POST /api/v1/statuses + Bearer). L'accès API n'est
# PAS ouvert librement : le fondateur doit le demander. Shadow tant qu'absent.
# Fit audience ~nul vs ICP Argos (CTO/RSSI FR) — canal exploratoire.
# Token = access token de l'app/compte Truth Social (style Mastodon).
# Test : scripts/test_truth_social.py
TRUTH_SOCIAL_INSTANCE_URL=https://truthsocial.com
TRUTH_SOCIAL_ACCESS_TOKEN=

# --- LinkedIn ---
# Setup côté LinkedIn Developer Portal (https://www.linkedin.com/developers/apps) :
#   - 2 apps distinctes : "Argos Ops" (perso) + "Argos Ops Page" (Page)
#   - Pour CHAQUE app : Auth → Authorized redirect URLs → ajouter
#     `http://localhost:8000/callback` (utilisé par les scripts OAuth helpers)
#   - Products à activer :
#     · App #1 : "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
#     · App #2 : "Sign In with LinkedIn using OpenID Connect" + "Community Management API"
#       (CMA = review LinkedIn 0-14j, parfois plus — cf. memo project)
LINKEDIN_PAGE_ID=
LINKEDIN_PAGE_URN=
# URN du profil perso, format urn:li:person:xxx. Rempli auto par le script OAuth.
LINKEDIN_PERSONAL_URN=

# App #1 "Argos Ops" — M1 (manuel) : Auth tab → Client Secret + Authorized redirect URL
# Puis : uv run python scripts/oauth_linkedin_personal.py  (token écrit auto ici)
LINKEDIN_PERSONAL_CLIENT_ID=
LINKEDIN_PERSONAL_CLIENT_SECRET=
LINKEDIN_PERSONAL_ACCESS_TOKEN=

# App #2 "Argos Ops Page" — M2 (manuel) : idem App #1 + CMA approuvée
# Puis : uv run python scripts/oauth_linkedin_page.py
LINKEDIN_PAGE_CLIENT_ID=
LINKEDIN_PAGE_CLIENT_SECRET=
LINKEDIN_PAGE_ACCESS_TOKEN=

# --- Email OVH Zimbra (P5 EmailBot — D-018, remplace Gmail API) ---
# Stack standard OVH Zimbra : ssl0.ovh.net IMAP 993 / SMTP 465
EMAIL_IMAP_HOST=ssl0.ovh.net
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=ssl0.ovh.net
EMAIL_SMTP_PORT=465
EMAIL_USER=contact@omnividens.fr
EMAIL_PASSWORD=
EMAIL_REPLY_NAME=Argos par Omnividens
# Signature email (cohérente sur tous les envois). Override optionnel —
# les defaults dans argos_ops/config.py couvrent le cas standard.
EMAIL_SIGNATURE_TAGLINE=Argos — on scanne, vous corrigez.
EMAIL_SIGNATURE_SITE_URL=https://omnividens.fr
EMAIL_SIGNATURE_AI_DISCLOSURE=Cette réponse a été rédigée par notre assistant Argos Ops et validée par un humain.

# --- Gmail (DÉPRÉCIÉ pour Argos Ops par D-018) ---
# Conservé pour Google Calendar éventuel ou intégrations futures non-email.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_INBOX_ADDRESS=

# --- Stripe (P7 FinanceBot — partage avec SecHunter, P0 décision) ---
# M3 (manuel) : Stripe Dashboard → Developers → Webhooks
#   - Endpoint URL : https://ops.omnividens.fr/api/stripe/webhook
#   - Events to send : invoice.*, customer.subscription.*, charge.dispute.*
#   - Copier "Signing secret" (whsec_…) ici
# Sans STRIPE_WEBHOOK_SECRET le endpoint répond 503 (refuse events non vérifiables).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Garde-fou : par défaut FALSE — le bot synchronise les companies + calcule
# le MRR + notifie Discord, mais NE PASSE PAS d'envoi outbound de relances.
# Activer (true) après avoir audité le wording sur un premier run live.
FINANCEBOT_DUNNING_ENABLED=false

# --- Google Ads (P12, optionnel — à remplir si AdBot active) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# --- Meta Ads (P12, optionnel) ---
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=

# --- Analytics (à remplir en INFRA-02 — Umami self-host) ---
UMAMI_BASE_URL=
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_WEBSITE_ID=

# --- Admin Control Panel (P16) ---
# Auth Basic du panel
OPS_DASHBOARD_BASIC_AUTH_USER=
OPS_DASHBOARD_BASIC_AUTH_PASSWORD=
# JWT secret pour les sessions admin
OPS_DASHBOARD_JWT_SECRET=
# IP allowlist (séparée par virgules) — vide = pas de filtrage
OPS_DASHBOARD_IP_ALLOWLIST=
# TOTP 2FA (optionnel, activé en P16.D)
OPS_DASHBOARD_TOTP_SECRET=

# --- Domaine secondaire outbound (P13 OutboundBot, ~10€/an) ---
OUTBOUND_DOMAIN=
OUTBOUND_FROM_NAME=
OUTBOUND_FROM_EMAIL=
