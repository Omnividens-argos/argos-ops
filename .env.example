# =============================================================================
# Argos Ops — .env.example
#
# Copie ce fichier vers .env.local (dev) ou .env (prod).
# JAMAIS committer .env.local ou .env (gitignored).
# =============================================================================

# --- Core ---
ARGOS_OPS_LOG_LEVEL=INFO

# --- Database (Postgres + pgvector) ---
# Prod : DB argos_ops sur cluster sechunter-postgres-1 (D-002)
# Dev local : adapter selon votre setup local
DATABASE_URL=postgresql://argos_ops:CHANGE_ME@localhost:5432/argos_ops

# --- Redis ---
# Prod : DB index 3 (SecHunter utilise 0-2)
REDIS_URL=redis://localhost:6379/3

# --- Google AI Studio (Gemini) ---
# Free tier 1M tokens/jour — chat live (P8) + embeddings KB (P3)
GEMINI_API_KEY=

# --- Discord ---
# 4 webhooks, un par canal (cf. P1.B)
DISCORD_WEBHOOK_DIGEST=
DISCORD_WEBHOOK_ESCALATIONS=
DISCORD_WEBHOOK_ALERTS=
DISCORD_WEBHOOK_OPS_LOGS=
# User ID du fondateur pour @mentions sur breakers critiques
DISCORD_FOUNDER_USER_ID=

# --- Reddit (à remplir avant P11 — todo P11-PREP) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=argos-ops-bot/0.1 by Omnividens

# --- Mastodon (remplace X — D-004 — à remplir avant P11) ---
MASTODON_INSTANCE_URL=https://infosec.exchange
MASTODON_ACCESS_TOKEN=

# --- LinkedIn ---
# Page Omnividens
LINKEDIN_PAGE_ID=
LINKEDIN_PAGE_URN=

# App #1 "Argos Ops" — Sign In with LinkedIn + Share on LinkedIn (profil perso)
LINKEDIN_PERSONAL_CLIENT_ID=
LINKEDIN_PERSONAL_CLIENT_SECRET=
LINKEDIN_PERSONAL_ACCESS_TOKEN=

# App #2 "Argos Ops Page" — Community Management API (post sur Page Omnividens)
LINKEDIN_PAGE_CLIENT_ID=
LINKEDIN_PAGE_CLIENT_SECRET=
LINKEDIN_PAGE_ACCESS_TOKEN=

# --- Gmail (à remplir en P5 / OAuth Google Cloud) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_INBOX_ADDRESS=contact@omnividens.fr

# --- Stripe (à remplir en P7 — partage avec SecHunter) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google Ads (P12, optionnel — à remplir si AdBot active) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# --- Meta Ads (P12, optionnel) ---
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=

# --- Analytics (à remplir en INFRA-02 — Umami self-host) ---
UMAMI_BASE_URL=
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_WEBSITE_ID=

# --- Admin Control Panel (P16) ---
# Auth Basic du panel
OPS_DASHBOARD_BASIC_AUTH_USER=
OPS_DASHBOARD_BASIC_AUTH_PASSWORD=
# JWT secret pour les sessions admin
OPS_DASHBOARD_JWT_SECRET=
# IP allowlist (séparée par virgules) — vide = pas de filtrage
OPS_DASHBOARD_IP_ALLOWLIST=
# TOTP 2FA (optionnel, activé en P16.D)
OPS_DASHBOARD_TOTP_SECRET=

# --- Domaine secondaire outbound (P13 OutboundBot, ~10€/an) ---
OUTBOUND_DOMAIN=
OUTBOUND_FROM_NAME=
OUTBOUND_FROM_EMAIL=
