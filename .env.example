# =============================================================================
# Argos Ops — .env.example
#
# Copie ce fichier vers .env.local (dev) ou .env (prod).
# JAMAIS committer .env.local ou .env (gitignored).
# =============================================================================

# --- Core ---
ARGOS_OPS_LOG_LEVEL=INFO

# --- Database (Postgres + pgvector) ---
# Prod : DB argos_ops sur cluster sechunter-postgres-1 (D-002)
# Dev local : adapter selon votre setup local
DATABASE_URL=postgresql://argos_ops:CHANGE_ME@localhost:5432/argos_ops

# --- Redis ---
# Prod : DB index 3 (SecHunter utilise 0-2)
REDIS_URL=redis://localhost:6379/3

# --- Google AI Studio (Gemini) — DÉPRÉCIÉ pour Argos Ops par D-017 ---
# Argos Ops ne l'utilise plus : agents via Claude Code Pro Max, embeddings KB
# via fastembed local (paraphrase-multilingual-mpnet-base-v2). Conservé
# optionnel uniquement si tu utilises ce repo pour piloter le scanner
# SecHunter BYOK (D-011, produit séparé). Laisse vide sinon.
GEMINI_API_KEY=

# --- Discord ---
# 4 webhooks, un par canal (cf. P1.B)
DISCORD_WEBHOOK_DIGEST=
DISCORD_WEBHOOK_ESCALATIONS=
DISCORD_WEBHOOK_ALERTS=
DISCORD_WEBHOOK_OPS_LOGS=
# Optionnel — webhook dédié inbox EmailBot (P5). Fallback sur ESCALATIONS si vide.
DISCORD_WEBHOOK_INBOX=
# User ID du fondateur pour @mentions sur breakers critiques
DISCORD_FOUNDER_USER_ID=

# --- Reddit retiré du périmètre Argos Ops par D-022 (2026-05-15) ---
# (Vars supprimées : REDDIT_CLIENT_ID, REDDIT_CLIENT_SECRET, REDDIT_USER_AGENT)

# --- Outbound (P13 — shadow mode par défaut) ---
# Live mode = envoi réel via SMTP depuis le domaine secondaire.
# Reste sur false tant que le domaine n'est pas acheté + warmed-up 4 semaines.
OUTBOUND_LIVE_MODE=false
# Domaine secondaire sacrificiel (P13 § 13.2) — ex: try-omnividens.com
OUTBOUND_FROM_DOMAIN=
# Secret HMAC pour signer les liens d'opt-out (génère via : python -c "import secrets; print(secrets.token_hex(32))")
OUTBOUND_UNSUBSCRIBE_SECRET=
# Cap journalier d'envois (warmup commence à 5, croisière 30-50)
OUTBOUND_DAILY_MAX=30

# --- Mastodon (remplace X — D-004 — à remplir avant P11) ---
MASTODON_INSTANCE_URL=https://infosec.exchange
MASTODON_ACCESS_TOKEN=

# --- LinkedIn ---
# Page Omnividens
LINKEDIN_PAGE_ID=
LINKEDIN_PAGE_URN=

# App #1 "Argos Ops" — Sign In with LinkedIn + Share on LinkedIn (profil perso)
LINKEDIN_PERSONAL_CLIENT_ID=
LINKEDIN_PERSONAL_CLIENT_SECRET=
LINKEDIN_PERSONAL_ACCESS_TOKEN=

# App #2 "Argos Ops Page" — Community Management API (post sur Page Omnividens)
LINKEDIN_PAGE_CLIENT_ID=
LINKEDIN_PAGE_CLIENT_SECRET=
LINKEDIN_PAGE_ACCESS_TOKEN=

# --- Email OVH Zimbra (P5 EmailBot — D-018, remplace Gmail API) ---
# Stack standard OVH Zimbra : ssl0.ovh.net IMAP 993 / SMTP 465
EMAIL_IMAP_HOST=ssl0.ovh.net
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=ssl0.ovh.net
EMAIL_SMTP_PORT=465
EMAIL_USER=contact@omnividens.fr
EMAIL_PASSWORD=
EMAIL_REPLY_NAME=Argos par Omnividens
# Signature email (cohérente sur tous les envois). Override optionnel —
# les defaults dans argos_ops/config.py couvrent le cas standard.
EMAIL_SIGNATURE_TAGLINE=Argos — on scanne, vous corrigez.
EMAIL_SIGNATURE_SITE_URL=https://omnividens.fr
EMAIL_SIGNATURE_AI_DISCLOSURE=Cette réponse a été rédigée par notre assistant Argos Ops et validée par un humain.

# --- Gmail (DÉPRÉCIÉ pour Argos Ops par D-018) ---
# Conservé pour Google Calendar éventuel ou intégrations futures non-email.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_INBOX_ADDRESS=

# --- Stripe (P7 FinanceBot — partage avec SecHunter, P0 décision) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Garde-fou : par défaut FALSE — le bot synchronise les companies + calcule
# le MRR + notifie Discord, mais NE PASSE PAS d'envoi outbound de relances.
# Activer (true) après avoir audité le wording sur un premier run live.
FINANCEBOT_DUNNING_ENABLED=false

# --- Google Ads (P12, optionnel — à remplir si AdBot active) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# --- Meta Ads (P12, optionnel) ---
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=

# --- Analytics (à remplir en INFRA-02 — Umami self-host) ---
UMAMI_BASE_URL=
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_WEBSITE_ID=

# --- Admin Control Panel (P16) ---
# Auth Basic du panel
OPS_DASHBOARD_BASIC_AUTH_USER=
OPS_DASHBOARD_BASIC_AUTH_PASSWORD=
# JWT secret pour les sessions admin
OPS_DASHBOARD_JWT_SECRET=
# IP allowlist (séparée par virgules) — vide = pas de filtrage
OPS_DASHBOARD_IP_ALLOWLIST=
# TOTP 2FA (optionnel, activé en P16.D)
OPS_DASHBOARD_TOTP_SECRET=

# --- Domaine secondaire outbound (P13 OutboundBot, ~10€/an) ---
OUTBOUND_DOMAIN=
OUTBOUND_FROM_NAME=
OUTBOUND_FROM_EMAIL=
