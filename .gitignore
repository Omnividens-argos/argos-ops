# =============================================================================
# argos-ops — .gitignore
# =============================================================================

# Secrets (CRITIQUE — ne jamais committer)
.env
.env.local
*.local
*.key
*.pem
*.p12
*.pfx
secrets/
# Exception : journal de rotation = noms de secrets + dates, jamais les valeurs (P22.C SecretRotator).
!data/secrets/
!data/secrets/rotation_log.yaml
service-account*.json
credentials*.json
token.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# uv
.venv/
.uv/

# Données générées
data/embeddings/
data/_fetcher_cache/*
!data/_fetcher_cache/.gitkeep
# Outputs StrategyBot / BoardReporter (P22.E) — regénérés à chaque run
data/strategy/digest-*.md
data/strategy/board-*.md
# Outputs EditorialBot (Sprint contenu) — queue regénérée à chaque run
data/editorial/queue-*.yaml
# Journal d'audit atelier (Axe 4) — prompts + IP locaux, jamais committé
data/atelier_audit/
# État runtime des pôles (archi v2) — journaux / registres générés à l'exécution
data/poles/fleet_runlog.jsonl
data/poles/sre/runlog.jsonl
data/poles/sre/breakers.yaml
data/poles/sre/killswitch.yaml
logs/
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
.claude/settings.local.json
*.swp
*.swo
*.bak

# Node (frontend ops dashboard P16)
node_modules/
dist/
.next/
*.tsbuildinfo

# ui-ux-pro-max skill data — symlinks vers clone externe
# (nextlevelbuilder/ui-ux-pro-max-skill). Pas committables sur Windows
# (NTFS symlinks). Installer en local via la procédure du SKILL.md.
.claude/skills/ui-ux-pro-max/data
.claude/skills/ui-ux-pro-max/scripts
