# Variables du stack Umami self-host (INFRA-02).
# Copier en `.env` DANS CE DOSSIER (infra/docker/umami/.env, gitignored) sur le
# serveur prod, puis `docker compose up -d`. Ne JAMAIS committer les valeurs.
#
# Ces secrets sont DISTINCTS des UMAMI_* du .env applicatif Argos Ops (racine) :
#   - ici  = secrets d'INFRA du container (DB, signature sessions)
#   - racine = identifiants de LECTURE de l'API par LandingOptimizer

# Mot de passe Postgres dédié à Umami (générer : openssl rand -base64 24).
UMAMI_DB_PASSWORD=

# Secret de signature des sessions Umami (générer : openssl rand -base64 32).
# Le changer invalide toutes les sessions admin en cours.
UMAMI_APP_SECRET=

# Nom du réseau Docker du container Caddy prod (sechunter-caddy-1) à rejoindre
# pour que Caddy proxy vers `umami:3000`. Inspecter avec :
#   docker inspect sechunter-caddy-1 -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}'
UMAMI_CADDY_NETWORK=sechunter_default
